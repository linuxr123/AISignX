# AISignX — Caddy reverse proxy (generated by scripts/setup_https.sh or .ps1)
#
# AISignX listens on http://127.0.0.1:5000 (no TLS). Caddy terminates HTTPS on :443.
#
# Public hostname  → free Let's Encrypt certificate (ports 80 and 443 must reach this host)
# localhost / LAN IP → Caddy "tls internal" (browser will warn once; enables offline SW on https://)

# --- Public domain (Let's Encrypt automatic) ---
# signage.example.com {
#     reverse_proxy 127.0.0.1:5000
# }

# --- Local / LAN (trusted after accepting browser warning) ---
# localhost {
#     tls internal
#     reverse_proxy 127.0.0.1:5000
# }
